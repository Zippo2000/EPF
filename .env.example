# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored and must not be committed.

# Required. Your Immich server API key.
# Get it from: Immich Web UI -> Administration -> Security & Privacy -> API Keys
# The key must have at least the "asset.download" permission.
IMMICH_API_KEY=

# Optional. Override the published host port (default: 15001).
# EPF_PORT=15001

# Optional. Timezone for sleep-window and wake-up schedule evaluation.
# Without this the base image runs in UTC. Zone data is already in the image.
# TZ=Europe/Berlin
