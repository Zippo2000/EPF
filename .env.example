# =============================================================================
# EPF configuration template.
#
#   cp .env.example .env      # then fill in your values
#
# .env is gitignored and must NEVER be committed. Keep real credentials only
# there. Everything below is optional except where marked "Required".
# =============================================================================

# --- Server (consumed by docker-compose.yml) --------------------------------
# Required. Immich API key (needs the "asset.download" permission).
# Get it: Immich Web UI -> Administration -> Security & Privacy -> API Keys.
IMMICH_API_KEY=

# Timezone for the sleep-window / wake-up schedule (default: Europe/Berlin).
# Without it the base image runs in UTC and the windows land at the wrong hour.
TZ=Europe/Berlin

# Host port the Flask server is published on (default: 15001).
EPF_PORT=15001

# (Optional) Photo/tracking directory inside the container (default: /photos).
# Only needed if you change the ./photos bind mount in docker-compose.yml.
# IMMICH_PHOTO_DEST=/photos

# --- Test harness (consumed by scripts/run-live-tests.sh) --------------------
# These are used only by the automated LIVE tests (scripts/run-live-tests.sh),
# not by the running frame (that one is configured through the web UI).
#
# Base URL of the Immich server to test against. No trailing slash.
IMMICH_URL=http://192.168.1.10:2283

# Album the live tests exercise.
IMMICH_ALBUM=default_album
